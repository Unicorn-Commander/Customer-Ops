# ─────────────────────────────────────────────────────────────────────────────
# Customer-Ops — environment
#
# Copy to `.env` and fill in. The cockpit runs fully on the CORE block alone;
# every federation seam, the knowledge graph, the AI, and SSO are OPTIONAL and
# DEGRADE-CLEAN — leave a *_BASE_URL (or FALKORDB_URL / AGENT_INFERENCE_BASE_URL)
# blank and that surface simply renders "connect" and makes no call.
#
# Never commit a real .env. Every value below is a SAFE placeholder.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3211
API_PREFIX=api/v1
LOG_LEVEL=info

# Postgres. DATABASE_URL is the app (NOBYPASSRLS) role; ADMIN_DATABASE_URL is the
# owner used for migrations only. Keep them DISTINCT in production (RLS depends on
# the app role NOT bypassing row security).
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://localhost:5432/customer_ops
ADMIN_DATABASE_URL=postgresql://localhost:5432/customer_ops

# ── Web ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://customer-ops.example.com
CORS_ORIGIN=https://customer-ops.example.com
NEXT_PUBLIC_API_URL=https://customer-ops.example.com/api/v1   # baked into the frontend at build time

# ── Platform hardening ───────────────────────────────────────────────────────
# All OPTIONAL; each default == the prior behavior, so an existing deploy needs
# none of these. A 0 / negative / garbage value falls back to the default
# (fail-safe, never fail-open).
#
# Reverse-proxy hop count. The app reads the client IP from X-Forwarded-For to
# do per-IP rate limiting; behind a proxy this MUST equal the number of trusted
# proxy hops in front of it, or every client is seen as one IP and per-IP
# protection collapses. Default: 1 (one hop, e.g. a single Traefik). Set to the
# real hop count behind a CDN+Traefik chain. (Can also be a literal like 'true'.)
TRUST_PROXY=1
#
# Swagger: docs serve at ${API_PREFIX}/docs. ON outside production; in production
# they are OFF unless SWAGGER_ENABLED=true (don't publish the API surface map by
# default in prod).
# SWAGGER_ENABLED=false
# The Swagger UI bundle's CSP grants its inline script/style by default. Set
# false for the strictest self-only CSP (do this when Swagger is disabled in prod).
# SWAGGER_CSP_RELAXED=false
#
# Request body cap (a cheap DoS guard — this is a metadata API; large uploads
# federate to the file engines, never here). Byte count or <number><unit>
# (b/kb/mb/gb). Default: 1mb.
# BODY_LIMIT=1mb
#
# Rate limiting — two named throttlers ('short' burst + 'long' sustained). The
# defaults are the prior hard-coded values; tune per-window here.
# RATE_LIMIT_SHORT_TTL_MS=60000     # burst window length (ms)
# RATE_LIMIT_SHORT_LIMIT=20         # requests / burst window
# RATE_LIMIT_LONG_TTL_MS=3600000    # sustained window length (ms)
# RATE_LIMIT_LONG_LIMIT=200         # requests / sustained window
#
# Error tracking (degrade-clean). With SENTRY_DSN UNSET the tracker is a no-op —
# the global RFC-7807 filter still logs every 5xx locally with its request-id.
# Set a DSN to route server faults to an external tracker.
# SENTRY_DSN=

# ── Auth / SSO (Keycloak, RS256, aud=customer-ops) ───────────────────────────
# Customer-Ops is SSO-only. Leave blank for a local dev build that mints its own
# session token; set for real SSO.
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=uchub
KEYCLOAK_CLIENT_ID=customer-ops
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_CALLBACK_URL=https://customer-ops.example.com/api/v1/auth/keycloak/callback
# Signs the local HS256 session token issued after the Keycloak callback. The
# verifier FAILS CLOSED if this is empty (it will not accept any local token), so
# this is REQUIRED for a working login. Generate: openssl rand -base64 64
JWT_SECRET=change-me-long-random
JWT_EXPIRES_IN=2d

# ── Tenancy (Postgres RLS) ───────────────────────────────────────────────────
# OFF = single-workspace; flip ON only after running scripts/verify-tenancy.sh
# AND pointing DATABASE_URL at the NOBYPASSRLS app role.
CUSTOMER_OPS_TENANCY_ENABLED=false
DEFAULT_WORKSPACE_ID=                 # the bootstrap workspace id (uc-registry uuidv7)
CUSTOMER_OPS_ACCESS_LIST=             # who may sign in / their seed role; `email-or-pattern:ROLE` CSV
# JIT-provisioning policy for a verified SSO user NOT matched by the access list.
# 'invite' (DEFAULT) = invite-only: a uchub account alone does NOT grant a
# Customer-Ops account; a stranger is rejected. 'open' = self-serve: a stranger
# auto-provisions their OWN workspace (a new uc-registry id + an OWNER membership).
# SECURITY-RELEVANT — 'open' lets anyone with a uchub login in. Anything but a
# case-insensitive 'open' fails safe to invite-only.
CUSTOMER_OPS_SIGNUP_MODE=invite

# uc-registry — mints the real workspace id for a self-serve ('open') signup.
# UNSET = degrade-clean: signups fall back to a locally-generated uuidv7 (still
# works; the id just isn't registry-canonical). Required for proper multi-tenant
# self-serve. UC_REGISTRY_TOKEN is forwarded as a bearer when set.
UC_REGISTRY_URL=
UC_REGISTRY_TOKEN=
UC_REGISTRY_TIMEOUT_MS=8000

# ── Federation broker (Brigade RFC-8693 token exchange) ──────────────────────
BRIGADE_EXPECTED_AUDIENCE=customer-ops                        # inbound: tokens addressed to us
BRIGADE_TRUSTED_ISSUERS=https://brigade.unicorncommander.ai   # inbound: who we trust (CSV; "" disables)
# Outbound mint uses the Keycloak client above. BRIGADE_EXCHANGE_URL defaults to
# the prod broker's /api/v1/federation/token (override only for a different broker).
# BRIGADE_EXCHANGE_URL=https://brigade.unicorncommander.ai/api/v1/federation/token
# BRIGADE_EXCHANGE_TIMEOUT_MS=8000

# Health-probe workspace. GET /health/integrations probes each seam; for a seam
# WITHOUT its own *_WORKSPACE_OVERRIDE it uses this workspace id to address the
# probe call. Set it to a real workspace the siblings recognize so the probe
# reflects a true auth result (otherwise a workspace-less probe may read as an
# auth/argument error). Optional.
HEALTH_PROBE_WORKSPACE_ID=

# ── Knowledge graph (FalkorDB) ───────────────────────────────────────────────
FALKORDB_URL=redis://unicorn-falkordb:6379   # blank = graph dormant (DB-only relationship view)

# ── AI relationship agents (LiteLLM gateway) ─────────────────────────────────
AGENT_INFERENCE_BASE_URL=http://unicorn-litellm:4000   # blank = agents return "connect inference"
AGENT_INFERENCE_SERVICE_TOKEN=                          # the customer-ops virtual key
AGENT_INFERENCE_BUNDLED_MODEL=qwen3.6-35b-a3b           # local default lane
AGENT_INFERENCE_METERED_MODEL=claude-sonnet-4.6         # frontier lane (opt-in: ?tier=metered)
AGENT_INFERENCE_TIMEOUT_MS=30000
# Entitlement mode for the agent lane. Honors UC_ENTITLEMENT_MODE (below) first,
# then this. Leave unset to use the suite-wide var.
# AGENT_INFERENCE_ENTITLEMENT_MODE=enforce
# Suite-wide entitlement mode for the agent lane AND the cross-app federation
# triggers (invoicing / starting a campaign / sending mail). 'open' = bootstrap
# (allow + loud WARN, before Lago emits the claim); 'enforce' once entitlements
# are verified. Default (unset) = enforce. Each client reads this first, falling
# back to its own legacy *_CROSS_APP_ENTITLEMENT_MODE.
UC_ENTITLEMENT_MODE=open

# ── Federation seams ─────────────────────────────────────────────────────────
# Per seam: BASE_URL (blank = dormant), AUTH_MODE (static | brigade-sts;
# brigade-sts mints a per-request RFC-8693 token with the seam's audience),
# AUDIENCE (the token `aud`), and a WORKSPACE_OVERRIDE that maps THIS app's local
# workspace id to the canonical id the sibling recognizes (each app has its own —
# do not assume they match). SERVICE_TOKEN is used ONLY when AUTH_MODE=static.
# Reads are viewer-level; a cross-app WRITE additionally requires the target SKU
# (see UC_ENTITLEMENT_MODE).

# Contact-Ops — contacts / orgs / sourcing (the canonical phonebook)
CONTACT_OPS_BASE_URL=
CONTACT_OPS_AUTH_MODE=brigade-sts
CONTACT_OPS_AUDIENCE=contact-ops
CONTACT_OPS_WORKSPACE_OVERRIDE=
CONTACT_OPS_INGEST_TOOL=upsert_person      # the CO MCP tool used to upsert a person
CONTACT_OPS_SERVICE_TOKEN=                 # only for AUTH_MODE=static
CONTACT_OPS_TIMEOUT_MS=8000

# Accounting-Ops — invoices / AR (the one AR engine). NOTE: MCP is at /mcp/.
AO_BASE_URL=
AO_AUTH_MODE=brigade-sts
AO_AUDIENCE=accounting-ops
AO_WORKSPACE_OVERRIDE=
AO_SERVICE_TOKEN=
AO_TIMEOUT_MS=10000

# Email-Ops — mailbox threads + send
EMAIL_OPS_BASE_URL=
EMAIL_OPS_AUTH_MODE=brigade-sts
EMAIL_OPS_AUDIENCE=email-ops
EMAIL_OPS_WORKSPACE_OVERRIDE=
EMAIL_OPS_SERVICE_TOKEN=
EMAIL_OPS_TIMEOUT_MS=10000

# Meeting-Ops — meetings / summaries / action items
MEETING_OPS_BASE_URL=
MEETING_OPS_AUTH_MODE=brigade-sts
MEETING_OPS_AUDIENCE=meeting-ops
MEETING_OPS_MCP_PATH=/mcp                   # JSON-RPC path on the base; MO's federation router is /api/federation/mcp
MEETING_OPS_WORKSPACE_OVERRIDE=
MEETING_OPS_SERVICE_TOKEN=
MEETING_OPS_TIMEOUT_MS=8000

# Project-Ops — projects / delivery status
PROJECT_OPS_BASE_URL=
PROJECT_OPS_AUTH_MODE=brigade-sts
PROJECT_OPS_AUDIENCE=project-ops
PROJECT_OPS_SCOPE=projects:read             # scope requested in the brigade-sts exchange
PROJECT_OPS_WORKSPACE_OVERRIDE=
PROJECT_OPS_SERVICE_TOKEN=                  # only for AUTH_MODE=static
PROJECT_OPS_SEARCH_LIMIT=25                 # max projects pulled per customer-360 lookup
PROJECT_OPS_TIMEOUT_MS=8000

# Outreach — campaigns / social touches
OUTREACH_BASE_URL=
OUTREACH_AUTH_MODE=brigade-sts
OUTREACH_AUDIENCE=outreach
OUTREACH_WORKSPACE_OVERRIDE=
OUTREACH_SERVICE_TOKEN=
OUTREACH_TIMEOUT_MS=10000

# ── Lead intake ──────────────────────────────────────────────────────────────
# For a lead that arrives with no contactId and that Contact-Ops can't (yet)
# resolve: ON (DEFAULT) mints a local provisional id so the lead is captured
# immediately and upgraded to a canonical Contact-Ops id later. Set to 'false'
# (or 0/no/off) to make such leads sit PENDING instead of provisional.
# LEAD_INTAKE_PROVISIONAL_IDENTITY=true

# ── Test-only ────────────────────────────────────────────────────────────────
# NOT used by the running app — these point the RLS integration tests at the app
# (NOBYPASSRLS) and owner roles. Set them in the test environment only:
#   CUSTOMER_OPS_RLS_TEST_DATABASE_URL=postgresql://localhost:5432/customer_ops
#   CUSTOMER_OPS_RLS_OWNER_DATABASE_URL=postgresql://localhost:5432/customer_ops
