# ─────────────────────────────────────────────────────────────────────────────
# Customer-Ops — environment
#
# Self-host: run `node deploy/selfhost/bootstrap.cjs` from the repo root. It
# creates deploy/.env with fresh credentials; do not copy this blank template
# and expect login to work. The self-host compose bundles the required SSO.
# Federation, graph and inference are optional: blank URLs make no calls.
#
# Never commit a real .env. Every value below is a SAFE placeholder.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3211
API_PREFIX=api/v1
LOG_LEVEL=info

# Generated separately for the app database, runtime role, identity database,
# Keycloak management account and Customer-Ops administrator. Never reuse them.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
CUSTOMER_OPS_ADMIN_PASSWORD=
# The self-host compose builds separate admin/runtime URLs from the above.
# For other deployment files, configure these explicitly.
DATABASE_URL=
ADMIN_DATABASE_URL=

# ── Web ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://127.0.0.1:3000
CORS_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:3211/api/v1   # baked into the frontend at build time
# Optional public API origin used in MCP OAuth metadata and 401 challenges.
# Leave unset to derive the trusted forwarded proto/host at request time.
PUBLIC_API_BASE_URL=
# Extra browser origins allowed on the MCP Streamable HTTP path (CSV; optional).
MCP_CORS_ORIGINS=

# ── Platform hardening ───────────────────────────────────────────────────────
# All OPTIONAL; each default == the prior behavior, so an existing deploy needs
# none of these. A 0 / negative / garbage value falls back to the default
# (fail-safe, never fail-open).
#
# Reverse-proxy hop count. The app reads the client IP from X-Forwarded-For to
# do per-IP rate limiting; behind a proxy this MUST equal the number of trusted
# proxy hops in front of it, or every client is seen as one IP and per-IP
# protection collapses. Default: 1 (one hop, e.g. a single Traefik). Set to the
# real hop count behind a CDN+Traefik chain. (Can also be a literal like 'true'.)
TRUST_PROXY=0
#
# Swagger: docs serve at ${API_PREFIX}/docs. ON outside production; in production
# they are OFF unless SWAGGER_ENABLED=true (don't publish the API surface map by
# default in prod).
# SWAGGER_ENABLED=false
# The Swagger UI bundle's CSP grants its inline script/style by default. Set
# false for the strictest self-only CSP (do this when Swagger is disabled in prod).
# SWAGGER_CSP_RELAXED=false
#
# Request body cap (a cheap DoS guard — this is a metadata API; large uploads
# federate to the file engines, never here). Byte count or <number><unit>
# (b/kb/mb/gb). Default: 1mb.
# BODY_LIMIT=1mb
#
# Rate limiting — two named throttlers ('short' burst + 'long' sustained). The
# defaults are the prior hard-coded values; tune per-window here.
# RATE_LIMIT_SHORT_TTL_MS=60000     # burst window length (ms)
# RATE_LIMIT_SHORT_LIMIT=20         # requests / burst window
# RATE_LIMIT_LONG_TTL_MS=3600000    # sustained window length (ms)
# RATE_LIMIT_LONG_LIMIT=200         # requests / sustained window
#
# Shared state (Redis) — OPTIONAL, degrade-clean. UNSET (default) → single-use
# security state (M365 OAuth nonces, Relations-Officer pending confirms) + the
# rate-limit counter live in-process (correct for ONE replica). Set REDIS_URL to
# move them to shared Redis so a 2nd backend replica shares them (a replayed
# nonce is rejected on any replica; a pending confirm survives a restart / works
# cross-replica; the rate limit is one budget, not N). Required before scaling
# the backend past 1 replica.
# REDIS_URL=redis://customer-ops-redis:6379
#
# Database reliability — OPTIONAL. statement_timeout bounds a runaway query so
# one bad plan can't pin a pooled connection (default 15000ms; 0 disables). Pool
# sizing appends Prisma's connection_limit / pool_timeout to DATABASE_URL when
# set (unset → Prisma default num_cpus*2+1). Pipeline board card cap bounds the
# hottest, federation-heavy page (default 500).
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_POOL_SIZE=10
# DB_POOL_TIMEOUT_SECONDS=10
# PIPELINE_MAX_CARDS=500
#
# Background reconciliation scheduler — OPTIONAL, OFF by default. When ON, runs
# lead-reconciliation / invoice-refresh / graph-repair per workspace on an
# interval (not only when someone POSTs the endpoint). Each cadence is ms; 0
# disables that one job. Enable per box, not per replica cluster (each replica
# would run its own loop — fine, jobs are idempotent, but pick one owner if that
# doubles load).
# RECONCILE_SCHEDULER_ENABLED=false
# RECONCILE_LEADS_INTERVAL_MS=300000       # 5m  (0 = off)
# REFRESH_INVOICES_INTERVAL_MS=900000      # 15m (0 = off)
# REPAIR_GRAPH_INTERVAL_MS=3600000         # 60m (0 = off)
#
# Error tracking (degrade-clean). With SENTRY_DSN UNSET the tracker is a no-op —
# the global RFC-7807 filter still logs every 5xx locally with its request-id.
# Set a DSN to route server faults to an external tracker.
# SENTRY_DSN=

# ── Auth / SSO (Keycloak, RS256, aud=customer-ops) ───────────────────────────
# Customer-Ops is SSO-only. The self-host stack imports its own customer-ops
# realm and admin. KEYCLOAK_URL is overridden to the internal service by compose;
# KEYCLOAK_PUBLIC_URL is the browser-facing address.
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_PUBLIC_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=customer-ops
KEYCLOAK_CLIENT_ID=customer-ops
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_CALLBACK_URL=http://127.0.0.1:3211/api/v1/auth/keycloak/callback
# Keycloak MCP audience binding. Default false is LOG-ONLY during rollout;
# set true after the shared realm's MCP audience scope is deployed.
KEYCLOAK_ENFORCE_AUDIENCE=false
# CSV additions to KEYCLOAK_CLIENT_ID for aud/azp matching (optional).
KEYCLOAK_EXPECTED_AUDIENCES=
# Signs the local HS256 session token issued after the Keycloak callback. The
# verifier FAILS CLOSED if this is empty (it will not accept any local token), so
# this is REQUIRED for a working login. The bootstrap generates it.
JWT_SECRET=
JWT_EXPIRES_IN=2d

# ── Tenancy (Postgres RLS) ───────────────────────────────────────────────────
# The self-host migration job configures the NOBYPASSRLS runtime role first.
CUSTOMER_OPS_TENANCY_ENABLED=true
DEFAULT_WORKSPACE_ID=                 # the bootstrap workspace id (uc-registry uuidv7)
CUSTOMER_OPS_ACCESS_LIST=admin@example.invalid:OWNER  # local realm bootstrap account
# JIT-provisioning policy for a verified SSO user NOT matched by the access list.
# 'invite' (application default) = invite-only: an SSO account alone does NOT grant a
# Customer-Ops account; a stranger is rejected. 'open' = self-serve: a stranger
# auto-provisions their OWN workspace (a new uc-registry id + an OWNER membership).
# 'open' lets users of the configured realm in; bundled realm registration is
# disabled. Anything but a case-insensitive 'open' fails safe to invite-only.
CUSTOMER_OPS_SIGNUP_MODE=open

# uc-registry — mints the real workspace id for a self-serve ('open') signup.
# UNSET = degrade-clean: signups fall back to a locally-generated uuidv7 (still
# works; the id just isn't registry-canonical). Required for proper multi-tenant
# self-serve. UC_REGISTRY_TOKEN is forwarded as a bearer when set.
UC_REGISTRY_URL=
UC_REGISTRY_TOKEN=
UC_REGISTRY_TIMEOUT_MS=8000

# ── Federation broker (Brigade RFC-8693 token exchange) ──────────────────────
BRIGADE_EXPECTED_AUDIENCE=customer-ops                        # inbound: tokens addressed to us
BRIGADE_TRUSTED_ISSUERS=   # blank disables inbound federation
# Outbound mint uses the Keycloak client above. BRIGADE_EXCHANGE_URL defaults to
# the prod broker's /api/v1/federation/token (override only for a different broker).
# BRIGADE_EXCHANGE_URL=https://brigade.unicorncommander.ai/api/v1/federation/token
# BRIGADE_EXCHANGE_TIMEOUT_MS=8000

# Health-probe workspace. GET /health/integrations probes each seam; for a seam
# WITHOUT its own *_WORKSPACE_OVERRIDE it uses this workspace id to address the
# probe call. Set it to a real workspace the siblings recognize so the probe
# reflects a true auth result (otherwise a workspace-less probe may read as an
# auth/argument error). Optional.
HEALTH_PROBE_WORKSPACE_ID=

# ── Knowledge graph (FalkorDB) ───────────────────────────────────────────────
FALKORDB_URL=   # blank = graph dormant (DB-only relationship view)

# ── AI relationship agents (LiteLLM gateway) ─────────────────────────────────
AGENT_INFERENCE_BASE_URL=   # blank = agents return "connect inference"
AGENT_INFERENCE_SERVICE_TOKEN=                          # the customer-ops virtual key
AGENT_INFERENCE_BUNDLED_MODEL=qwen3.6-35b-a3b           # local default lane
AGENT_INFERENCE_METERED_MODEL=claude-sonnet-4.6         # frontier lane (opt-in: ?tier=metered)
AGENT_INFERENCE_TIMEOUT_MS=30000
# Entitlement mode for the agent lane. Honors UC_ENTITLEMENT_MODE (below) first,
# then this. Leave unset to use the suite-wide var.
# AGENT_INFERENCE_ENTITLEMENT_MODE=enforce
# Suite-wide entitlement mode for the agent lane AND the cross-app federation
# triggers (invoicing / starting a campaign / sending mail). 'open' = bootstrap
# (allow + loud WARN, before Lago emits the claim); 'enforce' once entitlements
# are verified. Default (unset) = enforce. Each client reads this first, falling
# back to its own legacy *_CROSS_APP_ENTITLEMENT_MODE.
UC_ENTITLEMENT_MODE=open

# ── Entitlements source (Ops-Center GET /api/v1/entitlements) ─────────────────
# The suite entitlements authority. When set, the EntitlementsInterceptor calls it
# post-auth with the user's Keycloak access token and re-sources the verified SKUs
# (replacing the token claim) for BOTH the launch gate and the dual-SKU federation
# gates. BLANK = dormant: the token-claim source (JwtStrategy.readEntitlements) is
# used, exactly as before. Only RS256 uchub/Keycloak bearers are forwarded; a local
# HS256 session token degrades cleanly to the claim.
#   Prod:    https://unicorncommander.ai/api/v1/entitlements
#   Dogfood: https://magicunicorn.dev/api/v1/entitlements
ENTITLEMENTS_ENDPOINT_URL=
# Cache the result ~60s per (user, org) — an upgrade takes effect within the TTL.
ENTITLEMENTS_CACHE_TTL_MS=60000
# Per-call timeout; on 5xx/timeout we fail-soft to last-good for a known org,
# fail-closed (claim fallback) for a never-seen one.
ENTITLEMENTS_TIMEOUT_MS=5000
# Launch gate: 'enforce' denies (403) an authenticated request whose org lacks
# ENTITLEMENTS_LAUNCH_FEATURE_KEY, on a DEFINITIVE answer. Default off (source-only).
# ENTITLEMENTS_LAUNCH_GATE=enforce
ENTITLEMENTS_LAUNCH_FEATURE_KEY=customer_ops_access
# Pass the active workspace as ?org_id=<mapped Ops-Center org id>. Leave false to
# query the user's PRIMARY org (omit org_id) — correct for single-workspace today.
# Set true only once CO workspace ids == Ops-Center org ids (mapping firms up).
ENTITLEMENTS_WORKSPACE_IS_ORG=false

# ── Federation seams ─────────────────────────────────────────────────────────
# Per seam: BASE_URL (blank = dormant), AUTH_MODE (static | brigade-sts;
# brigade-sts mints a per-request RFC-8693 token with the seam's audience),
# AUDIENCE (the token `aud`), and a WORKSPACE_OVERRIDE that maps THIS app's local
# workspace id to the canonical id the sibling recognizes (each app has its own —
# do not assume they match). SERVICE_TOKEN is used ONLY when AUTH_MODE=static.
# Reads are viewer-level; a cross-app WRITE additionally requires the target SKU
# (see UC_ENTITLEMENT_MODE).

# Contact-Ops — contacts / orgs / sourcing (the canonical phonebook)
CONTACT_OPS_BASE_URL=
CONTACT_OPS_AUTH_MODE=brigade-sts
CONTACT_OPS_AUDIENCE=contact-ops
CONTACT_OPS_WORKSPACE_OVERRIDE=
CONTACT_OPS_INGEST_TOOL=upsert_person      # the CO MCP tool used to upsert a person
CONTACT_OPS_SERVICE_TOKEN=                 # only for AUTH_MODE=static
CONTACT_OPS_TIMEOUT_MS=8000

# Accounting-Ops — invoices / AR (the one AR engine). NOTE: MCP is at /mcp/.
AO_BASE_URL=
AO_AUTH_MODE=brigade-sts
AO_AUDIENCE=accounting-ops
AO_WORKSPACE_OVERRIDE=
AO_SERVICE_TOKEN=
AO_TIMEOUT_MS=10000

# Email-Ops — mailbox threads + send
EMAIL_OPS_BASE_URL=
EMAIL_OPS_AUTH_MODE=brigade-sts
EMAIL_OPS_AUDIENCE=email-ops
EMAIL_OPS_WORKSPACE_OVERRIDE=
EMAIL_OPS_SERVICE_TOKEN=
EMAIL_OPS_TIMEOUT_MS=10000
# Outbound / agent kill switch: workspace-scoped + runtime (NOT an env var).
# A workspace OWNER toggles Workspace.agentsPaused via
# PATCH /api/v1/workspaces/:workspaceId/agent-pause to halt agent runs +
# mode=send outbound email for that workspace immediately (no restart).

# Meeting-Ops — meetings / summaries / action items
MEETING_OPS_BASE_URL=
MEETING_OPS_AUTH_MODE=brigade-sts
MEETING_OPS_AUDIENCE=meeting-ops
MEETING_OPS_MCP_PATH=/mcp                   # JSON-RPC path on the base; MO's federation router is /api/federation/mcp
MEETING_OPS_WORKSPACE_OVERRIDE=
MEETING_OPS_SERVICE_TOKEN=
MEETING_OPS_TIMEOUT_MS=8000

# Project-Ops — projects / delivery status
PROJECT_OPS_BASE_URL=
PROJECT_OPS_AUTH_MODE=brigade-sts
PROJECT_OPS_AUDIENCE=project-ops
PROJECT_OPS_SCOPE=projects:read             # scope requested in the brigade-sts exchange
PROJECT_OPS_WORKSPACE_OVERRIDE=
PROJECT_OPS_SERVICE_TOKEN=                  # only for AUTH_MODE=static
PROJECT_OPS_SEARCH_LIMIT=25                 # max projects pulled per customer-360 lookup
PROJECT_OPS_TIMEOUT_MS=8000

# Outreach — campaigns / social touches
OUTREACH_BASE_URL=
OUTREACH_AUTH_MODE=brigade-sts
OUTREACH_AUDIENCE=outreach
OUTREACH_SCOPE=outreach:read outreach:send  # least-privilege scopes for the brigade-sts exchange
OUTREACH_WORKSPACE_OVERRIDE=
OUTREACH_SERVICE_TOKEN=                      # only for AUTH_MODE=static
OUTREACH_TIMEOUT_MS=10000

# ── Microsoft 365 connector (m365) ───────────────────────────────────────────
# A signed-in user links their OWN Microsoft 365 account (OAuth) and pulls their
# Outlook contacts INTO Customer-Ops through the existing lead-intake funnel.
# DORMANT until M365_CLIENT_ID is set: blank ⇒ the connector ships inert (status
# {configured:false}, the connect button disabled, oauth/start a clean 503).
# Azure setup: Entra ID → App registrations → Web platform, redirect =
# M365_REDIRECT_URI, delegated Graph scopes = offline_access User.Read Contacts.Read.
M365_CLIENT_ID=                # blank = connector dormant (no behavior change)
M365_CLIENT_SECRET=
M365_TENANT_ID=common          # 'common' (multi-tenant + personal), 'organizations', or a tenant GUID
M365_REDIRECT_URI=http://127.0.0.1:3211/api/v1/m365/oauth/callback
M365_SCOPES=offline_access User.Read Contacts.Read
M365_TOKEN_ENC_KEY=            # base64 32 bytes (`openssl rand -base64 32`); REQUIRED when M365_CLIENT_ID is set — boots fail-closed without it
M365_SYNC_PAGE_SIZE=50
M365_TIMEOUT_MS=15000
# M365_STATE_TTL_SECONDS=600   # OAuth state JWT lifetime (signed, single-use)
# M365_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

BRAND_OPS_BASE_URL=
CONVERSATIONS_OPS_BASE_URL=

# ── Lead intake ──────────────────────────────────────────────────────────────
# For a lead that arrives with no contactId and that Contact-Ops can't (yet)
# resolve: ON (DEFAULT) mints a local provisional id so the lead is captured
# immediately and upgraded to a canonical Contact-Ops id later. Set to 'false'
# (or 0/no/off) to make such leads sit PENDING instead of provisional.
# LEAD_INTAKE_PROVISIONAL_IDENTITY=true

# ── Test-only ────────────────────────────────────────────────────────────────
# NOT used by the running app — these point the RLS integration tests at the app
# (NOBYPASSRLS) and owner roles. Set them in the test environment only:
#   CUSTOMER_OPS_RLS_TEST_DATABASE_URL=postgresql://localhost:5432/customer_ops
#   CUSTOMER_OPS_RLS_OWNER_DATABASE_URL=postgresql://localhost:5432/customer_ops
