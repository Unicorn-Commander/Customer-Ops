# =====================================================================
# Customer-Ops — Backend environment template
# Copy to .env and fill in. Never commit .env.
# =====================================================================

# --- Database ---
# Runtime connects as the OBJECT OWNER in Phase 1 (RLS created-but-inert).
# Phase 3 flips this to the NOBYPASSRLS `customer_ops_app` role to make the
# tenant fence live. See infrastructure/database/init/01-init.sql + the RLS
# migration for the role split.
DATABASE_URL=postgresql://localhost:5432/customer_ops
# Admin/DDL connection used for migrations (owner role). Optional in dev.
ADMIN_DATABASE_URL=postgresql://localhost:5432/customer_ops

# --- Application ---
NODE_ENV=production
PORT=3211
API_PREFIX=api/v1
LOG_LEVEL=info

# --- Platform hardening (all OPTIONAL; every value has a safe default == the
#     prior behavior, so an existing deploy needs NONE of these). ---
#
# Swagger: docs serve at ${API_PREFIX}/docs. ON outside production; in production
# they are OFF unless SWAGGER_ENABLED=true (don't publish the API surface map by
# default in prod). Leave unset to keep the default posture.
# SWAGGER_ENABLED=false
# CSP for the Swagger UI bundle grants its inline script/style by default. Set to
# false for the strictest self-only CSP (do this when Swagger is disabled in prod).
# SWAGGER_CSP_RELAXED=false
#
# Request body cap (a cheap DoS guard — this is a metadata API; large uploads
# federate to the file engines, never here). Accepts a byte count or a
# <number><unit> token (b/kb/mb/gb). Garbage falls back to the default (never
# unbounded). Default: 1mb.
# BODY_LIMIT=1mb
#
# Rate limiting — two named throttlers ('short' burst + 'long' sustained). The
# defaults are the prior hard-coded values; tune per-window here. A 0/negative/
# garbage value falls back to the default (fail-safe, never fail-open). A
# deliberate disable is a deploy concern (drop the guard), never a stray env.
# RATE_LIMIT_SHORT_TTL_MS=60000     # burst window length (ms)
# RATE_LIMIT_SHORT_LIMIT=20         # requests / burst window
# RATE_LIMIT_LONG_TTL_MS=3600000    # sustained window length (ms)
# RATE_LIMIT_LONG_LIMIT=200         # requests / sustained window
#
# Error tracking (degrade-clean). With SENTRY_DSN UNSET the tracker is a pure
# no-op — the global RFC-7807 filter still logs every 5xx locally with its
# request-id. Set a DSN to route server faults to an external tracker. (The
# Sentry SDK is not a dependency yet; today this emits a structured fault line —
# wiring @sentry/node forwards capture() to it without touching call sites.)
# SENTRY_DSN=

# --- JWT (local sessions issued after the Keycloak OIDC callback) ---
# Generate: openssl rand -base64 64
JWT_SECRET=[GENERATE_64_BYTE_SECRET]
JWT_EXPIRES_IN=1d

# --- CORS / Frontend URL ---
CORS_ORIGIN=https://customerops.unicorncommander.ai
FRONTEND_URL=https://customerops.unicorncommander.ai

# --- Keycloak SSO (uchub realm on auth.unicorncommander.ai) ---
# aud=customer-ops (SUITE-IDENTITY §1: every app sets its own audience).
KEYCLOAK_URL=https://auth.unicorncommander.ai
KEYCLOAK_REALM=uchub
KEYCLOAK_CLIENT_ID=customer-ops
KEYCLOAK_CLIENT_SECRET=[FROM_KEYCLOAK_ADMIN_CLIENT_CREDENTIALS]
KEYCLOAK_CALLBACK_URL=/api/v1/auth/keycloak/callback

# --- Brigade federation (RS256; SUITE-IDENTITY §1/§D6) ---
# Comma-separated trusted issuer base URLs. Each issuer's JWKS is read from
# `<iss>/.well-known/jwks.json`. Set to "" to disable the federation branch.
# A Brigade token's `aud` MUST equal BRIGADE_EXPECTED_AUDIENCE (customer-ops)
# or it is rejected even when its signature + issuer verify.
BRIGADE_TRUSTED_ISSUERS=https://brigade.unicorncommander.ai
BRIGADE_EXPECTED_AUDIENCE=customer-ops

# --- Suite tenancy (SUITE-IDENTITY) ---
# Master switch. DEFAULT OFF == current behavior: workspace routes do NOT
# require a Membership row, the membership gate is a no-op, rows resolve to
# DEFAULT_WORKSPACE_ID, and the DB RLS is inert because the runtime still
# connects as the table owner. Flip to true (alongside pointing DATABASE_URL
# at the NOBYPASSRLS customer_ops_app role) to make the fence live.
CUSTOMER_OPS_TENANCY_ENABLED=false

# The single bootstrap/dogfood workspace id seeded by the RLS migration.
# uc-registry owns real workspace ids in production; Customer-Ops NEVER mints.
DEFAULT_WORKSPACE_ID=0190a000-7e57-7000-8000-00000000c007

# SSO access list — "who can sign into Customer-Ops + at what role on JIT".
# Comma-separated `email-or-pattern:role`. Roles: OWNER|ADMIN|MANAGER|MEMBER|VIEWER.
CUSTOMER_OPS_ACCESS_LIST="aaron@magicunicorn.tech:OWNER,shafenkhan@users.noreply.github.com:OWNER,*@magicunicorn.tech:MEMBER"

# --- Contact-Ops federation (Phase 2 — the relationship cockpit) ---
# Customer-Ops FEDERATES contacts from Contact-Ops; it NEVER copies them. The
# client speaks JSON-RPC to CO's `POST {BASE}/mcp` (get_person / list_people /
# search_people) and the signed `GET {BASE}/api/v1/workspaces/{id}` projection.
# The workspace is forwarded as the wire claim (X-Workspace-Id); CO re-gates
# membership server-side. Leave CONTACT_OPS_BASE_URL UNSET to run the cockpit
# with contact details shown as placeholders (degrade-clean — CO not required).
CONTACT_OPS_BASE_URL=
# Service bearer for the server-to-server federation call. The Phase-3 change
# swaps this for a Brigade RFC-8693 exchange minting a per-request token with
# aud=contact-ops + the addressed workspace_id claim (the seam is isolated in
# ContactOpsClient.authHeaders).
CONTACT_OPS_SERVICE_TOKEN=
# Federation call timeout (ms); default 8000.
CONTACT_OPS_TIMEOUT_MS=8000

# --- Accounting-Ops federation (Phase 3 — the invoicing surface) ---
# Customer-Ops FEDERATES invoicing to Accounting-Ops (the AR engine + the ledger
# system-of-record); it is NOT an invoicing engine and posts no journal entry.
# The client speaks JSON-RPC to AO's `POST {AO_BASE_URL}/mcp`
# (create_invoice_from_draft — idempotent on (workspace, external_source,
# external_ref) — and get_invoice for the status poll; AO emits NO webhooks).
# Leave AO_BASE_URL UNSET to run degrade-clean: the customer-360 invoice slot
# shows "connect Accounting-Ops" and no call is made (no hard AO dependency).
AO_BASE_URL=
# Service bearer for the server-to-server federation call. The Brigade change
# swaps this for an RFC-8693 exchange minting a per-request token with
# aud=accounting-ops + the addressed workspace_id claim (the seam is isolated in
# AccountingOpsClient.authHeaders).
AO_SERVICE_TOKEN=
# Federation call timeout (ms); default 10000.
AO_TIMEOUT_MS=10000

# --- Outreach federation (Phase 4 — the outreach surface) ---
# Customer-Ops FEDERATES outreach to the (future) Outreach app (the campaign
# engine-surface over Listmonk email + Postiz social); it is NOT a campaign
# engine and sends no campaign. The client speaks JSON-RPC to the app's
# `POST {OUTREACH_BASE_URL}/mcp` (list_campaigns / list_touches_for_contact;
# enroll_contact / schedule_social_touch — idempotent on (workspace,
# external_source, external_ref)). Leave OUTREACH_BASE_URL UNSET to run
# degrade-clean: the customer-360 outreach slot shows "connect Outreach" and no
# call is made (no hard Outreach dependency — the app is the next track).
OUTREACH_BASE_URL=
# Service bearer for the server-to-server federation call. The Brigade change
# swaps this for an RFC-8693 exchange minting a per-request token with
# aud=outreach + the addressed workspace_id claim (isolated in
# OutreachClient.authHeaders).
OUTREACH_SERVICE_TOKEN=
# Federation call timeout (ms); default 10000.
OUTREACH_TIMEOUT_MS=10000

# --- Email-Ops federation (Phase 4 — the email surface) ---
# Customer-Ops FEDERATES mailboxes to the (future) Email-Ops app (the mailbox
# surface over the Stalwart mail server); it is NOT a mail server and stores no
# message body. The client speaks JSON-RPC to the app's
# `POST {EMAIL_OPS_BASE_URL}/mcp` (list_threads_with_contact /
# list_thread_messages; compose_email with mode=send|draft — idempotent on
# (workspace, external_source, external_ref)). Leave EMAIL_OPS_BASE_URL UNSET to
# run degrade-clean: the customer-360 email slot shows "connect Email-Ops" and no
# call is made (no hard Email-Ops dependency — the app is the next track).
EMAIL_OPS_BASE_URL=
# Service bearer for the server-to-server federation call. The Brigade change
# swaps this for an RFC-8693 exchange minting a per-request token with
# aud=email-ops + the addressed workspace_id claim (isolated in
# EmailOpsClient.authHeaders).
EMAIL_OPS_SERVICE_TOKEN=
# Federation call timeout (ms); default 10000.
EMAIL_OPS_TIMEOUT_MS=10000

# ── Phase 5: the Meeting-Ops federation seam (conversation signal) ──
# Customer-Ops FEDERATES meetings/summaries/action-items from the Meeting-Ops app
# (the conversation-intelligence app; owns meetings/transcripts/summaries/action
# items) PURELY at read time to fill the customer-360 meeting slot — there is no
# local Meeting-Ops table; the signal is federated, never copied. The client
# speaks JSON-RPC to `POST {MEETING_OPS_BASE_URL}/mcp` (list_meetings_for_contact
# / list_summaries_for_contact / list_action_items_for_contact). Reads are
# viewer-level (no dual SKU). Leave MEETING_OPS_BASE_URL UNSET to run
# degrade-clean: the meeting slot shows "connect Meeting-Ops" and no call is made.
MEETING_OPS_BASE_URL=
# Service bearer for the server-to-server federation call. The Brigade change
# swaps this for an RFC-8693 exchange minting a per-request token with
# aud=meeting-ops + the addressed workspace_id claim (isolated in
# MeetingOpsClient.authHeaders).
MEETING_OPS_SERVICE_TOKEN=
# Federation call timeout (ms); default 8000.
MEETING_OPS_TIMEOUT_MS=8000

# ── Phase 5: the 4-lane agent-inference seam (ops-center routing + metering) ──
# The relationship AGENTS (lead-triage / follow-up drafter / collections nudge)
# compose the federation seams + customer data and hand a prompt to the
# control-plane inference gateway (ops-center uchub-litellm), which picks the lane
# (1-4) + meters it. Customer-Ops never runs a model, routes, or meters. The
# client posts an OpenAI-shaped request to `POST {AGENT_INFERENCE_BASE_URL}/v1/
# chat/completions`. Leave AGENT_INFERENCE_BASE_URL UNSET to run degrade-clean:
# the agents return a "connect inference" result (no draft) + their assembled
# context, and make no model call.
AGENT_INFERENCE_BASE_URL=
# Service bearer for the gateway call. The Brigade change swaps this for the agent
# token mint (isolated in AgentInferenceClient.authHeaders).
AGENT_INFERENCE_SERVICE_TOKEN=
# The lane-alias model names the gateway maps to a concrete model per tier (never
# a concrete model here — that is the gateway's job). Defaults: uc-bundled (lanes
# 1-2, in seat price) / uc-metered (lanes 3-4). Point these at your litellm model
# groups if they differ.
AGENT_INFERENCE_BUNDLED_MODEL=uc-bundled
AGENT_INFERENCE_METERED_MODEL=uc-metered
# Gateway call timeout (ms); default 30000.
AGENT_INFERENCE_TIMEOUT_MS=30000
# Entitlement mode for the inference lane (the metered/entitlement-gated lane in
# this phase). `customer-ops` is required to run any agent (bundled lanes 1-2); a
# 'metered' request (lanes 3-4) additionally requires `ai-metered`. Honors
# UC_ENTITLEMENT_MODE first (the suite-wide var below), falling back to this.
# AGENT_INFERENCE_ENTITLEMENT_MODE=enforce

# Entitlement mode for the cross-app federation gates. A cross-app TRIGGER —
# invoicing (Phase 3), starting a campaign / sending mail (Phase 4) — requires
# BOTH `customer-ops` AND the target app's SKU (`accounting-ops` / `outreach` /
# `email-ops`) on the bearer's entitlements. Reads (list invoices / campaigns /
# threads) are viewer-level (no dual SKU). Until Lago emits the claim, set `open`
# to allow the gates to run with a loud WARN (pre-Lago bootstrap); flip to
# `enforce` once entitlements are emitted + verified. This one var configures all
# the app gates — each client reads it first, falling back to its own legacy
# *_CROSS_APP_ENTITLEMENT_MODE. Default (unset) = enforce.
UC_ENTITLEMENT_MODE=open
