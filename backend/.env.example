# =====================================================================
# Customer-Ops — Backend environment template
# Copy to .env and fill in. Never commit .env.
# =====================================================================

# --- Database ---
# Runtime connects as the OBJECT OWNER in Phase 1 (RLS created-but-inert).
# Phase 3 flips this to the NOBYPASSRLS `customer_ops_app` role to make the
# tenant fence live. See infrastructure/database/init/01-init.sql + the RLS
# migration for the role split.
DATABASE_URL=postgresql://localhost:5432/customer_ops
# Admin/DDL connection used for migrations (owner role). Optional in dev.
ADMIN_DATABASE_URL=postgresql://localhost:5432/customer_ops

# --- Application ---
NODE_ENV=production
PORT=3211
API_PREFIX=api/v1
LOG_LEVEL=info

# --- JWT (local sessions issued after the Keycloak OIDC callback) ---
# Generate: openssl rand -base64 64
JWT_SECRET=[GENERATE_64_BYTE_SECRET]
JWT_EXPIRES_IN=1d

# --- CORS / Frontend URL ---
CORS_ORIGIN=https://customerops.unicorncommander.ai
FRONTEND_URL=https://customerops.unicorncommander.ai

# --- Keycloak SSO (uchub realm on auth.unicorncommander.ai) ---
# aud=customer-ops (SUITE-IDENTITY §1: every app sets its own audience).
KEYCLOAK_URL=https://auth.unicorncommander.ai
KEYCLOAK_REALM=uchub
KEYCLOAK_CLIENT_ID=customer-ops
KEYCLOAK_CLIENT_SECRET=[FROM_KEYCLOAK_ADMIN_CLIENT_CREDENTIALS]
KEYCLOAK_CALLBACK_URL=/api/v1/auth/keycloak/callback

# --- Brigade federation (RS256; SUITE-IDENTITY §1/§D6) ---
# Comma-separated trusted issuer base URLs. Each issuer's JWKS is read from
# `<iss>/.well-known/jwks.json`. Set to "" to disable the federation branch.
# A Brigade token's `aud` MUST equal BRIGADE_EXPECTED_AUDIENCE (customer-ops)
# or it is rejected even when its signature + issuer verify.
BRIGADE_TRUSTED_ISSUERS=https://brigade.unicorncommander.ai
BRIGADE_EXPECTED_AUDIENCE=customer-ops

# --- Suite tenancy (SUITE-IDENTITY) ---
# Master switch. DEFAULT OFF == current behavior: workspace routes do NOT
# require a Membership row, the membership gate is a no-op, rows resolve to
# DEFAULT_WORKSPACE_ID, and the DB RLS is inert because the runtime still
# connects as the table owner. Flip to true (alongside pointing DATABASE_URL
# at the NOBYPASSRLS customer_ops_app role) to make the fence live.
CUSTOMER_OPS_TENANCY_ENABLED=false

# The single bootstrap/dogfood workspace id seeded by the RLS migration.
# uc-registry owns real workspace ids in production; Customer-Ops NEVER mints.
DEFAULT_WORKSPACE_ID=0190a000-7e57-7000-8000-00000000c007

# SSO access list — "who can sign into Customer-Ops + at what role on JIT".
# Comma-separated `email-or-pattern:role`. Roles: OWNER|ADMIN|MANAGER|MEMBER|VIEWER.
CUSTOMER_OPS_ACCESS_LIST="aaron@magicunicorn.tech:OWNER,shafenkhan@users.noreply.github.com:OWNER,*@magicunicorn.tech:MEMBER"

# --- Contact-Ops federation (Phase 2 — the relationship cockpit) ---
# Customer-Ops FEDERATES contacts from Contact-Ops; it NEVER copies them. The
# client speaks JSON-RPC to CO's `POST {BASE}/mcp` (get_person / list_people /
# search_people) and the signed `GET {BASE}/api/v1/workspaces/{id}` projection.
# The workspace is forwarded as the wire claim (X-Workspace-Id); CO re-gates
# membership server-side. Leave CONTACT_OPS_BASE_URL UNSET to run the cockpit
# with contact details shown as placeholders (degrade-clean — CO not required).
CONTACT_OPS_BASE_URL=
# Service bearer for the server-to-server federation call. The Phase-3 change
# swaps this for a Brigade RFC-8693 exchange minting a per-request token with
# aud=contact-ops + the addressed workspace_id claim (the seam is isolated in
# ContactOpsClient.authHeaders).
CONTACT_OPS_SERVICE_TOKEN=
# Federation call timeout (ms); default 8000.
CONTACT_OPS_TIMEOUT_MS=8000

# --- Accounting-Ops federation (Phase 3 — the invoicing surface) ---
# Customer-Ops FEDERATES invoicing to Accounting-Ops (the AR engine + the ledger
# system-of-record); it is NOT an invoicing engine and posts no journal entry.
# The client speaks JSON-RPC to AO's `POST {AO_BASE_URL}/mcp`
# (create_invoice_from_draft — idempotent on (workspace, external_source,
# external_ref) — and get_invoice for the status poll; AO emits NO webhooks).
# Leave AO_BASE_URL UNSET to run degrade-clean: the customer-360 invoice slot
# shows "connect Accounting-Ops" and no call is made (no hard AO dependency).
AO_BASE_URL=
# Service bearer for the server-to-server federation call. The Brigade change
# swaps this for an RFC-8693 exchange minting a per-request token with
# aud=accounting-ops + the addressed workspace_id claim (the seam is isolated in
# AccountingOpsClient.authHeaders).
AO_SERVICE_TOKEN=
# Federation call timeout (ms); default 10000.
AO_TIMEOUT_MS=10000

# Entitlement mode for the AO invoicing gate. Invoicing requires BOTH
# `customer-ops` AND `accounting-ops` on the bearer's entitlements. Until Lago
# emits the claim, set `open` to allow the gate to run with a loud WARN (pre-Lago
# bootstrap); flip to `enforce` once entitlements are emitted + verified. This
# var configures BOTH apps — Customer-Ops reads it first, falling back to AO's
# own legacy AO_CROSS_APP_ENTITLEMENT_MODE. Default (unset) = enforce.
UC_ENTITLEMENT_MODE=open
